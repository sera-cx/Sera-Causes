# ---- Chain ----
CHAIN_ID=11155111                     # 11155111 Sepolia, 1 mainnet
RPC_URL=https://sepolia.infura.io/v3/<key>
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REGISTRY_FROM_BLOCK=0
FRONTEND_TAG=causes.sera.cx

# ---- Finaliser / steward (server-side only, phase 0 and 1) ----
FINALISER_PRIVATE_KEY=                # submits claim and round results on-chain

# ---- Database (indexer + API) ----
DATABASE_URL=postgresql://localhost:5432/sera_causes

# ---- API ----
API_PORT=3001
PUBLIC_API_URL=http://localhost:3001
UPLOAD_DIR=./uploads                  # evidence files; IPFS pinning is a later step

# ---- Privy (wallet sign-in, same model as g.sera.cx and sera-pay) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=

# ---- Sera.cx settlement (protected layer) ----
SERA_NETWORK=sepolia                  # sepolia | mainnet
SERA_API_KEY=
SERA_API_SECRET=

# ---- gSera (g.sera.cx) ----
GSERA_MODE=mock                       # mock | live
GSERA_BASE_URL=https://g.sera.cx
GSERA_HMAC_KEY=                       # CAUSES_HMAC_KEY on the gSera side

# ---- KYT/KYA (kyt.sera.cx; stub until the API is shared) ----
KYT_MODE=stub                         # stub | live
KYT_BASE_URL=https://kyt.sera.cx
KYT_API_KEY=
KYT_FAIL_CLOSED=false

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Care Share Donate <causes@sera.cx>

# ---- Verification mode (brief phase 0 = advisory, phase 1 = community) ----
VERIFICATION_MODE=advisory

# ---- Web ----
VITE_API_URL=http://localhost:3001
VITE_CHAIN_ID=11155111
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
WEB_PORT=3100
