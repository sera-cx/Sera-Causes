# Production environment for causes.sera.cx
#
# Copy to `.env` on the server, next to docker-compose.yml, and fill in.
# Never commit the filled-in file.
#
# THIS IS A PREVIEW. The defaults below keep every money path in mock or
# stub mode. Lines marked SET BEFORE REAL LAUNCH must be filled before the
# site handles anything real.

# ---- Ports on the host ----------------------------------------------------
# Check nothing else is bound first: ss -ltnp | grep -E '3001|3100'
WEB_PORT=3100
API_PORT=3001

# ---- Database -------------------------------------------------------------
POSTGRES_USER=sera_causes
POSTGRES_PASSWORD=                    # generate: openssl rand -base64 32
POSTGRES_DB=sera_causes
DATABASE_URL=postgresql://sera_causes:<the password above>@db:5432/sera_causes

# ---- Public URLs ----------------------------------------------------------
PUBLIC_WEB_URL=https://causes.sera.cx
PUBLIC_API_URL=https://causes.sera.cx

# Read at build time by Vite, so a change here needs a rebuild, not a restart.
VITE_API_URL=https://causes.sera.cx
VITE_CHAIN_ID=11155111
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ---- Chain ----------------------------------------------------------------
# No registry is deployed yet. While the address is zero the listener idles
# and the site serves seeded data only.
CHAIN_ID=11155111
RPC_URL=                              # SET BEFORE REAL LAUNCH
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REGISTRY_FROM_BLOCK=0
FRONTEND_TAG=causes.sera.cx

# Submits claim results on chain. Leave empty for the preview: the finaliser
# is run by hand, not by the server.
FINALISER_PRIVATE_KEY=                # SET BEFORE REAL LAUNCH

# ---- Sign-in (Privy) ------------------------------------------------------
# Sera's existing Privy app. causes.sera.cx must be added to its allowed
# origins. With these unset the site is read-only and every write returns a
# plain 503 rather than a confusing 401.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=

# ---- Verification ---------------------------------------------------------
# advisory: votes and tallies are shown, stewards finalise each claim.
VERIFICATION_MODE=advisory

# ---- Sera.cx settlement ---------------------------------------------------
SETTLEMENT_MODE=mock                  # SET BEFORE REAL LAUNCH: live
SERA_NETWORK=sepolia
SERA_API_KEY=
SERA_API_SECRET=

# ---- gSera ----------------------------------------------------------------
GSERA_MODE=mock                       # SET BEFORE REAL LAUNCH: live
GSERA_BASE_URL=https://g.sera.cx
GSERA_HMAC_KEY=                       # CAUSES_HMAC_KEY on the gSera side

# ---- Community XP ---------------------------------------------------------
# queue: XP events are recorded and held. The partner route is not agreed yet.
COMMUNITY_MODE=queue
COMMUNITY_BASE_URL=https://community.sera.cx
COMMUNITY_HMAC_KEY=

# ---- KYT and KYA ----------------------------------------------------------
# stub until the kyt.sera.cx API is shared. Its wire format is provisional
# and lives in packages/sera-settlement/src/kyt.ts.
KYT_MODE=stub                         # SET BEFORE REAL LAUNCH: live
KYT_BASE_URL=https://kyt.sera.cx
KYT_API_KEY=
KYT_FAIL_CLOSED=false

# ---- Email (Resend) -------------------------------------------------------
# Unset means notifications are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=Care Share Donate <causes@sera.cx>

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=info
